<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Sarabun:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="menubar.css">
    <link rel="stylesheet" href="sale_pr.css">
    <link rel="stylesheet" href="inventory.css">
    <link rel="stylesheet" href="model.css">
    <link rel="stylesheet" href="ai_widget.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title>คลังสินค้า - ERP System</title>
  <link rel="icon" href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/favicon.svg" type="image/svg+xml">
</head>

<body>
    <aside class="sidebar">
        <div class="logo">
            <h2>ระบบ ERP</h2>
            <span>ระดับจงกร</span><br>
        </div>

        <nav class="menu">
            <a href="<%= baseUrl %>/">Dashboard</a>
            <% if (!user || !user.role || ['admin', 'sales', 'procurement'].includes(user.role)) { %>
      <a href="<%= baseUrl %>/add_sale">เพิ่มออเดอร์</a>
      <% } %>
      <% if (!user || !user.role || user.role === 'admin' || user.role === 'sales') { %>
      <a href="<%= baseUrl %>/sale_pr">เสนอขาย</a>
            <a href="<%= baseUrl %>/sale_so">Sale SO</a>
      <% } %>
            <% if (!user || !user.role || user.role === 'admin' || user.role === 'procurement') { %>
      <a href="<%= baseUrl %>/precher_pr">เสนอซื้อ</a>
            <a href="<%= baseUrl %>/purchase_order">Purchase PO</a>
            <% } %>
      <% if (!user || !user.role || ['admin', 'sales', 'procurement'].includes(user.role)) { %>
      <a href="<%= baseUrl %>/inventory" class="active">คลังสินค้า</a>
      <% } %>
            <a href="<%= baseUrl %>/ai_chat"> AI Assistant</a>
            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
            <hr style="border-color: #333; margin: 10px 0;">
            <a href="<%= baseUrl %>/audit"><i class="fas fa-history"></i> ประวัติใช้งาน</a>
            <% } %>
        </nav>

        <div class="sidebar-footer">
            <div class="user-info">
        <i class="fas fa-user-circle"></i>
        <%= (typeof user !=='undefined' && user) ? user['ชื่อpic'] : 'Unknown' %>
        <br><small style="color: #ff7eb3; font-size: 0.75rem;">Role: <%= (typeof user !=='undefined' && user && user.role) ? user.role.toUpperCase() : 'USER' %></small>
      </div>
            <a href="<%= baseUrl %>/logout" class="btn-logout">
                <i class="fas fa-sign-out-alt"></i> ออกจากระบบ
            </a>
        </div>
    </aside>

    <main>
        <h1 class="page-title" style="color: #ff7eb3; margin-bottom: 20px;"><i class="fas fa-boxes"></i> รายการสินค้าในคลัง</h1>
        
        <form action="/inventory" method="GET" class="search-container">
            <input type="text" name="search" class="search-input" value="<%= search %>" placeholder="ค้นหาชื่อสินค้า, รหัส หรือแบรนด์...">
            <button type="submit" class="btn-search">
                <i class="fas fa-search"></i> ค้นหา
            </button>
            <a href="/inventory" class="btn-clear">
                <i class="fas fa-sync-alt"></i> ล้างค่า
            </a>
        </form>

        <div class="table-responsive" style="overflow-x: auto; width: 100%;">
            <table class="inventory-table">
                <thead>
                    <tr>
                        <% if (data && data.length > 0) { %>
                            <th>รหัส</th>
                            <th>ชื่อสินค้า</th>
                            <th>จำนวน</th>
                            <th>หน่วย</th>
                            <th>แบรนด์</th>
                            <th>ราคาขาย</th>
                            <th style="text-align: center;">จัดการ</th>
                        <% } %>
                    </tr>
                </thead>
                <tbody>
                    <% if (data && data.length > 0) { %>
                        <% data.forEach(row => { 
                            const stockQty = parseFloat(row['จำนวน']) || 0;
                            const isLowStock = stockQty > 0 && stockQty < 10;
                        %>
                            <tr>
                                <td><%= row['รหัส'] %></td>
                                <td style="white-space: normal; min-width: 200px;"><%= row['ชื่อ'] %></td>
                                <td style="font-weight: bold; color: #a786ff;" class="<%= isLowStock ? 'low-stock' : '' %>">
                                    <%= row['จำนวน'] %>
                                </td>
                                <td><%= row['หน่วย'] %></td>
                                <td><%= row['แบรนด์'] %></td>
                                <td><%= row['ราคาขาย'] %></td>
                                <td style="text-align: center;">
                                    <a href="javascript:void(0)" class="action-icon" onclick='openEditModal(<%- JSON.stringify(row) %>)'>
                                        <i class="fas fa-pencil"></i>
                                    </a>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" style="text-align: center; padding: 100px;">
                                <i class="fas fa-search-minus" style="font-size: 3rem; color: #2a1b3d; margin-bottom: 20px; display: block;"></i>
                                ไม่พบข้อมูลสินค้าในคลัง
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </main>

    <!-- Modal แก้ไขสินค้า -->
    <div id="editProductModal" class="modal-overlay">
        <div class="modal-panel" style="max-width: 800px; max-height: 90vh;">
            <div class="modal-header">
                <h2>จัดการข้อมูลสินค้าโดยละเอียด</h2>
            </div>
            <div class="modal-body">
                <input type="hidden" id="edit-id">
                <div class="edit-form-container">
                    <!-- ส่วนที่ 1: ข้อมูลพื้นฐาน -->
                    <div class="section-title"><i class="fas fa-info-circle"></i> ข้อมูลพื้นฐาน</div>
                    <div class="edit-form-group">
                        <label>รหัสสินค้า</label>
                        <input type="text" id="edit-code" class="edit-form-input" readonly style="opacity: 0.7;">
                    </div>
                    <div class="edit-form-group">
                        <label>บาร์โค้ด</label>
                        <input type="text" id="edit-barcode" class="edit-form-input">
                    </div>
                    <div class="edit-form-group full-width">
                        <label>ชื่อสินค้า</label>
                        <input type="text" id="edit-name" class="edit-form-input">
                    </div>
                    <div class="edit-form-group full-width">
                        <label>ชื่อจำเพราะ (Specification)</label>
                        <input type="text" id="edit-spec" class="edit-form-input">
                    </div>
                    <div class="edit-form-group">
                        <label>แบรนด์</label>
                        <input type="text" id="edit-brand" class="edit-form-input">
                    </div>
                    <div class="edit-form-group">
                        <label>หน่วย</label>
                        <input type="text" id="edit-unit" class="edit-form-input">
                    </div>

                    <!-- ส่วนที่ 2: หมวดหมู่และสถานะ -->
                    <div class="section-title"><i class="fas fa-tags"></i> หมวดหมู่และสถานะ</div>
                    <div class="edit-form-group">
                        <label>ประเภทสินค้า 1</label>
                        <input type="text" id="edit-type1" class="edit-form-input">
                    </div>
                    <div class="edit-form-group">
                        <label>ประเภทสินค้า 2</label>
                        <input type="text" id="edit-type2" class="edit-form-input">
                    </div>
                    <div class="edit-form-group">
                        <label>กลุ่มสินค้า</label>
                        <input type="text" id="edit-group" class="edit-form-input">
                    </div>
                    <div class="edit-form-group">
                        <label>สถานะ</label>
                        <select id="edit-status" class="edit-form-input">
                            <option value="ใช้งาน">ใช้งาน</option>
                            <option value="ระงับ">ระงับ</option>
                        </select>
                    </div>

                    <!-- ส่วนที่ 3: ราคาและภาษี -->
                    <div class="section-title"><i class="fas fa-money-bill-wave"></i> ราคาและภาษี</div>
                    <div class="edit-form-group">
                        <label>ราคาซื้อ (Cost)</label>
                        <input type="number" id="edit-cost" class="edit-form-input" min="0" step="any">
                    </div>
                    <div class="edit-form-group">
                        <label>ราคาขาย (Price)</label>
                        <input type="number" id="edit-price" class="edit-form-input" min="0" step="any">
                    </div>
                    <div class="edit-form-group">
                        <label>อัตราภาษีซื้อ</label>
                        <input type="text" id="edit-tax-buy" class="edit-form-input">
                    </div>
                    <div class="edit-form-group">
                        <label>อัตราภาษีขาย</label>
                        <input type="text" id="edit-tax-sell" class="edit-form-input">
                    </div>

                    <!-- ส่วนที่ 4: อื่นๆ -->
                    <div class="section-title"><i class="fas fa-ellipsis-h"></i> ข้อมูลเพิ่มเติม</div>
                    <div class="edit-form-group">
                        <label>จำกัดจำนวน</label>
                        <input type="number" id="edit-limit" class="edit-form-input">
                    </div>
                    <div class="edit-form-group">
                        <label>คีย์เวิร์ด (Keywords)</label>
                        <input type="text" id="edit-keywords" class="edit-form-input">
                    </div>
                    <div class="edit-form-group full-width">
                        <label>หมายเหตุ 1</label>
                        <input type="text" id="edit-note1" class="edit-form-input">
                    </div>
                    <div class="edit-form-group full-width">
                        <label>หมายเหตุ 2</label>
                        <input type="text" id="edit-note2" class="edit-form-input">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button class="btn-cancel" onclick="closeEditModal()">ยกเลิก</button>
                <button class="btn-confirm" onclick="saveProductChanges()">บันทึกการเปลี่ยนแปลง</button>
            </div>
        </div>
    </div>

    <script>
        // Show loading immediately on start
        Swal.fire({
            title: 'กำลังโหลดข้อมูล...',
            text: 'กรุณารอสักครู่ขณะระบบดึงข้อมูลคลังสินค้า',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            },
            background: '#1d112e',
            color: '#fff'
        });

        // Hide loading when page is fully loaded
        window.addEventListener('load', function() {
            Swal.close();
        });

        function openEditModal(product) {
            document.getElementById('edit-id').value = product['รหัส'];
            document.getElementById('edit-code').value = product['รหัส'];
            document.getElementById('edit-barcode').value = product['บาร์โค๊ด'] || "";
            document.getElementById('edit-name').value = product['ชื่อ'] || "";
            document.getElementById('edit-spec').value = product['ชื่อจำเพราะ'] || "";
            document.getElementById('edit-brand').value = product['แบรนด์'] || "";
            document.getElementById('edit-unit').value = product['หน่วย'] || "";
            
            document.getElementById('edit-type1').value = product['ประเภทสินค้า'] || "";
            document.getElementById('edit-type2').value = product['ประเภทสินค้า2'] || "";
            document.getElementById('edit-group').value = product['กลุ่มสินค้า'] || "";
            document.getElementById('edit-status').value = product['สถานะ'] || "ใช้งาน";
            
            document.getElementById('edit-cost').value = product['ราคาซื้อ'] || 0;
            document.getElementById('edit-price').value = product['ราคาขาย'] || 0;
            document.getElementById('edit-tax-buy').value = product['อัตราภาษีซื้อ'] || "0%";
            document.getElementById('edit-tax-sell').value = product['อัตราภาษีขาย'] || "0%";
            
            document.getElementById('edit-limit').value = product['จำกัดจำนวน'] || 0;
            document.getElementById('edit-keywords').value = product['ครีเวิด'] || "";
            document.getElementById('edit-note1').value = product['หมายเหตุ1'] || "";
            document.getElementById('edit-note2').value = product['หมายเหตุ2'] || "";
            
            document.getElementById('editProductModal').classList.add('show');
        }

        function closeEditModal() {
            document.getElementById('editProductModal').classList.remove('show');
        }

        async function saveProductChanges() {
            const id = document.getElementById('edit-id').value;

            // Validate: ราคาต้องไม่ติดลบ
            const costVal = parseFloat(document.getElementById('edit-cost').value);
            const priceVal = parseFloat(document.getElementById('edit-price').value);
            if (costVal < 0 || priceVal < 0) {
                Swal.fire({
                    icon: 'error',
                    title: 'ข้อมูลไม่ถูกต้อง',
                    text: 'ราคาซื้อและราคาขายต้องไม่ต่ำกว่า 0 กรุณาตรวจสอบข้อมูลอีกครั้ง',
                    background: '#1d112e',
                    color: '#fff'
                });
                return;
            }

            const updatedData = {
                'ชื่อ': document.getElementById('edit-name').value,
                'ชื่อจำเพราะ': document.getElementById('edit-spec').value,
                'หน่วย': document.getElementById('edit-unit').value,
                'ประเภทสินค้า': document.getElementById('edit-type1').value,
                'ประเภทสินค้า2': document.getElementById('edit-type2').value,
                'ราคาซื้อ': document.getElementById('edit-cost').value,
                'ราคาขาย': document.getElementById('edit-price').value,
                'อัตราภาษีซื้อ': document.getElementById('edit-tax-buy').value,
                'อัตราภาษีขาย': document.getElementById('edit-tax-sell').value,
                'บาร์โค๊ด': document.getElementById('edit-barcode').value,
                'ครีเวิด': document.getElementById('edit-keywords').value,
                'จำกัดจำนวน': document.getElementById('edit-limit').value,
                'สถานะ': document.getElementById('edit-status').value,
                'แบรนด์': document.getElementById('edit-brand').value,
                'กลุ่มสินค้า': document.getElementById('edit-group').value,
                'หมายเหตุ1': document.getElementById('edit-note1').value,
                'หมายเหตุ2': document.getElementById('edit-note2').value
            };

            Swal.fire({
                title: 'กำลังบันทึก...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: '#1d112e',
                color: '#fff'
            });

            try {
                const response = await fetch('/api/update_product', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ id, updatedData })
                });

                const result = await response.json();
                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'สำเร็จ',
                        text: result.message,
                        background: '#1d112e',
                        color: '#fff'
                    }).then(() => location.reload());
                } else {
                    throw new Error(result.error);
                }
            } catch (error) {
                Swal.fire({
                    icon: 'error',
                    title: 'ข้อผิดพลาด',
                    text: error.message,
                    background: '#1d112e',
                    color: '#fff'
                });
            }
        }

        // Show loading when form is submitted
        document.querySelector('.search-container').addEventListener('submit', function() {
            Swal.fire({
                title: 'กำลังค้นหา...',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                },
                background: '#1d112e',
                color: '#fff'
            });
        });
    </script>
    <script src="<%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/dynamic_favicon.js"></script>
</body>

</html>