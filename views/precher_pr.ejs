<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Sarabun:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap"
    rel="stylesheet">
  <link rel="stylesheet" href="menubar.css">
  <link rel="stylesheet" href="precher_pr.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

  <title>รายการเสนอซื้อ (PR) - ERP System</title>
</head>

<body>

  <aside class="sidebar">
    <div class="logo">
      <h2>ระบบ ERP</h2>
      <span>ระดับจงกร</span><br>
    </div>

    <nav class="menu">
      <a href="<%= baseUrl %>/">Dashboard</a>
      <a href="<%= baseUrl %>/add_sale">เพิ่มออเดอร์</a>
      <a href="<%= baseUrl %>/sale_pr">เสนอขาย</a>
      <a href="<%= baseUrl %>/sale_so">Sale SO</a>
      <a href="<%= baseUrl %>/precher_pr" class="active">เสนอซื้อ</a>
      <a href="<%= baseUrl %>/inventory">คลังสินค้า</a>
      <a href="<%= baseUrl %>/ai_chat"> AI Assistant</a>
    </nav>

    <div class="sidebar-footer">
      <div class="user-info">
        <i class="fas fa-user-circle"></i>
        <%= (typeof user !=='undefined' && user) ? user['ชื่อpic'] : 'Unknown' %>
      </div>
      <a href="<%= baseUrl %>/logout" class="btn-logout">
        <i class="fas fa-sign-out-alt"></i> ออกจากระบบ
      </a>
    </div>
  </aside>

  <main>
    <h1>
        <i class="fas fa-shopping-cart"></i> รายการเสนอซื้อ (PR)
    </h1>

    <div class="status-tabs">
      <a href="/precher_pr?status=ทั้งหมด&search=<%= search %>" class="status-tab <%= currentStatus === 'ทั้งหมด' ? 'active' : '' %>">
        <i class="fas fa-list"></i> ทั้งหมด
      </a>
      <a href="/precher_pr?status=ยังไม่ยืนยัน&search=<%= search %>" class="status-tab <%= currentStatus === 'ยังไม่ยืนยัน' ? 'active' : '' %>">
        <i class="fas fa-clock"></i> ยังไม่ยืนยัน
      </a>
      <a href="/precher_pr?status=ยืนยันแล้ว&search=<%= search %>" class="status-tab <%= currentStatus === 'ยืนยันแล้ว' ? 'active' : '' %>">
        <i class="fas fa-check-circle"></i> ยืนยันแล้ว
      </a>
    </div>

    <!-- Summary Cards -->
    <div class="summary-cards">
      <div class="stat-card">
        <div class="stat-icon">
          <i class="fas fa-file-invoice"></i>
        </div>
        <div>
          <div class="stat-label">จำนวนรายการทั้งหมด</div>
          <div class="stat-value">
            <%= data ? data.length : 0 %> รายการ
          </div>
        </div>
      </div>
    </div>

    <form action="/precher_pr" method="GET" class="search-container">
      <input type="hidden" name="status" value="<%= currentStatus %>">
      <input type="text" name="search" class="search-input" value="<%= search %>" placeholder="ค้นหาด้วยชื่อผู้ขาย หรือ ID...">

      <button type="submit" class="btn-search">
        <i class="fas fa-search"></i> ค้นหา
      </button>

      <a href="/precher_pr" class="btn-clear">
        <i class="fas fa-sync-alt"></i> ล้างค่า
      </a>
    </form>


    <div class="table-responsive">
      <table>
        <thead>
          <tr>
            <% if (data && data.length> 0) { %>
              <% Object.keys(data[0]).forEach(h=> { %>
                <th>
                  <%= h %>
                </th>
                <% }) %>
                  <th style="text-align: center;">จัดการ</th>
                  <th style="text-align: center;">พิมพ์</th>
                  <th style="text-align: center;">ยืนยัน</th>
                  <th style="text-align: center;">ลบ</th>
                  <% } %>
          </tr>
        </thead>
        <tbody>
          <% if (data && data.length> 0) { %>
            <% data.forEach(row=> { %>
              <tr>
                <% Object.entries(row).forEach(([key, val])=> { %>
                  <td>
                    <% if (key === 'สถานะเอกสาร') { %>
                      <span class="status-badge <%= (val === 'ยืนยันแล้ว' || val === 'สำเร็จ') ? 'status-success' : 'status-pending' %>">
                        <%= val %>
                      </span>
                    <% } else { %>
                      <%= val %>
                    <% } %>
                  </td>
                  <% }) %>

                    <td style="text-align: center;">
                      <a href="/edit_purchase?id=<%= row['id'] %>" class="action-btn edit-btn" title="แก้ไข">
                        <i class="fas fa-edit"></i>
                      </a>
                    </td>
                    <td style="text-align: center;">
                      <a href="javascript:void(0);" onclick="printPO('<%= row['id'] %>', '<%= encodeURIComponent(JSON.stringify(row)) %>')" class="action-btn" style="color: #4ade80;" title="พิมพ์ PO">
                        <i class="fas fa-print"></i>
                      </a>
                    </td>
                    <td style="text-align: center;">
                      <% if (!['ยืนยันแล้ว', 'สำเร็จ'].includes(row['สถานะเอกสาร'])) { %>
                        <a href="javascript:void(0);" onclick="confirmSendWebhook(this, '<%= row['id'] %>')"
                          class="action-btn confirm-btn" title="ยืนยัน">
                          <i class="fas fa-paper-plane"></i>
                        </a>
                      <% } else { %>
                        <span class="action-btn" style="color: #666; cursor: not-allowed; opacity: 0.5;">
                          <i class="fas fa-check-double"></i>
                        </span>
                      <% } %>
                    </td>
                    <td style="text-align: center;">
                      <a href="javascript:void(0);" onclick="deletePurchase('<%= row['id'] %>')" class="action-btn delete-btn" title="ลบ">
                        <i class="fa-solid fa-trash"></i>
                      </a>
                    </td>
              </tr>
              <% }) } else { %>
                <tr>
                  <td colspan="100%">
                    ไม่มีรายการในกลุ่มนี้
                  </td>
                </tr>
                <% } %>
        </tbody>
      </table>
    </div>
  </main>

  <script>
    async function printPO(id, encodedRow) {
      const headerData = JSON.parse(decodeURIComponent(encodedRow));
      const vendorName = headerData['ลูกค้า-ผู้ขาย'] || '';
      const preparedByName = '<%= user ? user['ชื่อpic'] : "Unknown" %>';

      Swal.fire({
        title: 'กำลังดึงข้อมูล...',
        text: 'กรุณารอสักครู่',
        allowOutsideClick: false,
        didOpen: () => {
          Swal.showLoading();
        },
        background: '#1d112e',
        color: '#fff'
      });

      try {
        // 1. ดึงข้อมูลลูกค้า
        let vendorAddress = "";
        let vendorCode = headerData['เลขที่'] || '';
        let vendorPhone = headerData['โทรศัพท์'] || '';

        try {
            const infoRes = await fetch(`/api/customer_info?name=${encodeURIComponent(vendorName)}`);
            const infoData = await infoRes.json();
            if (infoData.success) {
                vendorAddress = infoData.address || "";
                if (!vendorCode) vendorCode = infoData.code || "";
                if (!vendorPhone) vendorPhone = infoData.phone || "";
            }
        } catch (e) {
            console.warn("Could not fetch vendor info:", e);
        }

        // 2. ดึงข้อมูลสินค้าของ ID นี้
        const responseSub = await fetch(`/api/sub_purchase?id=${id}`);
        const subData = await responseSub.json();
        
        if (!subData.success || !subData.items.length) {
            throw new Error('ไม่พบรายการสินค้าสำหรับ ID นี้');
        }

        const itemsArray = subData.items.map((item, index) => {
            const itemObj = {};
            itemObj[`item${index + 1}`] = {
                'sku': item['สินค้า'] || '',
                'productName': item['ชื่อสินค้า'] || '',
                'qty': (item['จำนวน'] || '0').toString(),
                'unitPrice': (item['ราคาต่อหน่วย'] || '0').toString(),
                'total': (item['รวม'] || item['จำนวนเงิน'] || '0').toString()
            };
            return itemObj;
        });

        const payload = {
            id: id,
            orderDate: headerData['วันที่'] || '',
            title: 'ใบสั่งซื้อ',
            customerCode: vendorCode,
            contactName: headerData['ผู้ติดต่อ'] || '', 
            vendorName: vendorName,
            vendorAddress: vendorAddress,
            vendorPhone: vendorPhone,
            vendorPhoneExtra: headerData['เบอร์ติดต่อเพิ่มเติม'] || '',
            approvalNo: id,
            deliveryDate: headerData['วันที่ส่งมอบ'] || '', 
            creditDays: headerData['เครดิต (วัน)'] || '',
            paymentTerms: headerData['ประเภทธุรกรรม'] || '',
            preparedBy: preparedByName,
            grandTotal: subData.items.reduce((sum, item) => sum + (parseFloat(item['รวม'] || item['จำนวนเงิน']) || 0), 0),
            vat: subData.items.reduce((sum, item) => sum + (parseFloat(item['ภาษี']) || 0), 0),
            items: itemsArray
        };

        const printRes = await fetch('/api/generate-po-pdf', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        if (!printRes.ok) throw new Error('ไม่สามารถสร้าง PDF ได้');

        const blob = await printRes.blob();
        const pdfUrl = URL.createObjectURL(blob);
        window.open(pdfUrl, '_blank');
        Swal.close();

      } catch (err) {
        console.error('Print Error:', err);
        Swal.fire({
          icon: 'error',
          title: 'เกิดข้อผิดพลาด',
          text: err.message,
          background: '#1d112e',
          color: '#fff'
        });
      }
    }

    async function confirmSendWebhook(element, id) {
      const result = await Swal.fire({
        title: 'ยืนยันการส่งข้อมูล?',
        text: `ยืนยันที่จะส่งข้อมูล ID: ${id} ไปยัง Webhook ใช่หรือไม่?`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#ff7eb3',
        cancelButtonColor: '#281a3d',
        confirmButtonText: 'ยืนยันส่งข้อมูล',
        cancelButtonText: 'ยกเลิก',
        background: '#1d112e',
        color: '#fff'
      });

      if (!result.isConfirmed) return;

      Swal.fire({
        title: 'กำลังส่งข้อมูล...',
        allowOutsideClick: false,
        didOpen: () => {
          Swal.showLoading();
        },
        background: '#1d112e',
        color: '#fff'
      });

      try {
        const response = await fetch('/api/confirm-webhook-purchase', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: id })
        });

        const result = await response.json();

        if (response.ok && result.success) {
          let webhookMsg = result.webhookResponse?.message || result.webhookResponse?.msg || 'ระบบได้ทำการส่งข้อมูลและปรับปรุงสถานะเรียบร้อยแล้ว';
          const webhookTitle = result.webhookResponse?.title || 'ส่งข้อมูลสำเร็จ';
          const returnedId = result.webhookResponse?.id || result.webhookResponse?.ID;

          if (returnedId) {
            webhookMsg += `\nID: ${returnedId}`;
          }

          Swal.fire({
            icon: 'success',
            title: webhookTitle,
            text: webhookMsg,
            background: '#1d112e',
            color: '#fff',
            confirmButtonColor: '#ff7eb3'
          }).then(() => {
            window.location.reload();
          });
        } else {
          Swal.fire({
            icon: 'error',
            title: 'เกิดข้อผิดพลาด',
            text: result.error || 'ไม่สามารถส่งข้อมูลได้',
            background: '#1d112e',
            color: '#fff'
          });
        }
      } catch (err) {
        console.error('Error:', err);
        Swal.fire({
          icon: 'error',
          title: 'ผิดพลาด',
          text: 'เกิดข้อผิดพลาดในการเชื่อมต่อกับเซิร์ฟเวอร์',
          background: '#1d112e',
          color: '#fff'
        });
      }
    }

    function deletePurchase(id) {
        Swal.fire({
            title: 'ยืนยันการลบ?',
            text: `คุณแน่ใจนะว่าต้องการลบรายการ ID: ${id}?`,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#281a3d',
            confirmButtonText: 'ใช่, ลบเลย!',
            cancelButtonText: 'ยกเลิก',
            background: '#1d112e',
            color: '#fff'
        }).then((result) => {
            if (result.isConfirmed) {
                window.location.href = `/delpurchase?id=${id}`;
            }
        });
    }

    document.querySelector('.search-container').addEventListener('submit', function (e) {
      const btn = this.querySelector('.btn-search');
      btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> กำลังค้นหา...';
      btn.disabled = true;
    });
  </script>

</body>

</html>
