<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Kanit:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Sarabun:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="menubar.css">
    <link rel="stylesheet" href="edit_sale.css">
    <link rel="stylesheet" href="add_order.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <title>เพิ่มออเดอร์ใหม่</title>
  <link rel="icon" href="<%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/favicon.svg" type="image/svg+xml">
</head>

<body class="add-sale-page">
    <aside class="sidebar">
        <div class="logo">
            <h2>ระบบ ERP</h2>
            <span>ระดับจงกร</span><br>
        </div>

        <nav class="menu">
            <a href="<%= baseUrl %>/">Dashboard</a>
            <% if (!user || !user.role || ['admin', 'sales', 'procurement'].includes(user.role)) { %>
      <a href="<%= baseUrl %>/add_sale" class="active">เพิ่มออเดอร์</a>
      <% } %>
      <% if (!user || !user.role || user.role === 'admin' || user.role === 'sales') { %>
      <a href="<%= baseUrl %>/sale_pr">เสนอขาย</a>
            <a href="<%= baseUrl %>/sale_so">Sale SO</a>
      <% } %>
            <% if (!user || !user.role || user.role === 'admin' || user.role === 'procurement') { %>
      <a href="<%= baseUrl %>/precher_pr">เสนอซื้อ</a>
            <a href="<%= baseUrl %>/purchase_order">Purchase PO</a>
            <% } %>
      <% if (!user || !user.role || ['admin', 'sales', 'procurement'].includes(user.role)) { %>
      <a href="<%= baseUrl %>/inventory">คลังสินค้า</a>
      <% } %>            <a href="<%= baseUrl %>/ai_chat"> AI Assistant</a>
            <% if (typeof user !== 'undefined' && user && user.role === 'admin') { %>
            <hr style="border-color: #333; margin: 10px 0;">
            <a href="<%= baseUrl %>/audit"><i class="fas fa-history"></i> ประวัติใช้งาน</a>
            <% } %>
        </nav>
        <div class="sidebar-footer">
            <div class="user-info">
        <i class="fas fa-user-circle"></i>
        <%= (typeof user !=='undefined' && user) ? user['ชื่อpic'] : 'Unknown' %>
        <br><small style="color: #ff7eb3; font-size: 0.75rem;">Role: <%= (typeof user !=='undefined' && user && user.role) ? user.role.toUpperCase() : 'USER' %></small>
      </div>
            <a href="<%= baseUrl %>/logout" class="btn-logout">
                <i class="fas fa-sign-out-alt"></i> ออกจากระบบ
            </a>
        </div>
    </aside>

    <main class="content-area">
        <div class="page-container">
            <div class="form-card">
                <div class="form-header-premium">
                    <div class="header-main">
                        <h1>สร้างรายการใหม่</h1>
                        <p>กรุณาเลือกประเภทและกรอกรายละเอียดข้อมูลคู่ค้า</p>
                    </div>
                    <div class="header-accent"></div>
                </div>

            <form id="addOrderForm" class="main-form">
                <input type="hidden" name="วันที่" value="<%= today %>">
                <input type="hidden" name="PIC" value="<%= (typeof user !== 'undefined' && user) ? user['ชื่อภาษาอังกฤษpic'] : '' %>">

                <div class="input-section">
                    <h3 class="section-label">เลือกประเภทรายการ</h3>
                    <div class="selection-grid">
                        <% if (!user || !user.role || user.role === 'admin' || user.role === 'sales') { %>
                        <label class="select-card">
                            <input type="radio" name="orderType" value="sale" <%= (user && user.role === 'sales') ? 'checked' : 'checked' %>>
                            <div class="card-body">
                                <div class="icon-box sale">
                                    <i class="fas fa-file-invoice-dollar"></i>
                                </div>
                                <div class="text-box">
                                    <span class="label">เสนอขาย</span>
                                </div>
                                <div class="radio-indicator"></div>
                            </div>
                        </label>
                        <% } %>

                        <% if (!user || !user.role || user.role === 'admin' || user.role === 'procurement') { %>
                        <label class="select-card">
                            <input type="radio" name="orderType" value="purchase" <%= (user && user.role === 'procurement') ? 'checked' : '' %>>
                            <div class="card-body">
                                <div class="icon-box purchase">
                                    <i class="fas fa-cart-arrow-down"></i>
                                </div>
                                <div class="text-box">
                                    <span class="label">เสนอซื้อ</span>
                                </div>
                                <div class="radio-indicator"></div>
                            </div>
                        </label>
                        <% } %>
                    </div>
                </div>

                <div class="input-section">
                    <h3 class="section-label">ข้อมูลลูกค้า / รายละเอียด</h3>
                    <div class="textarea-container">
                        <textarea 
                            name="ลูกค้า-ผู้ขาย" 
                            placeholder="พิมพ์ชื่อบริษัท หรือรายละเอียดสำคัญที่นี่..." 
                            required 
                            autofocus
                        ></textarea>
                        <div class="focus-line"></div>
                    </div>
                </div>

                <div class="action-footer">
                    <% if (user && user.role === 'procurement') { %>
                        <a href="<%= baseUrl %>/precher_pr" class="btn-back">
                            <i class="fas fa-chevron-left"></i> กลับไปหน้าเสนอซื้อ
                        </a>
                    <% } else { %>
                        <a href="<%= baseUrl %>/sale_pr" class="btn-back">
                            <i class="fas fa-chevron-left"></i> กลับไปหน้าเสนอขาย
                        </a>
                    <% } %>
                    <button type="submit" class="btn-submit-premium" id="submitBtn">
                        <span>ยืนยันข้อมูลรายการ</span>
                        <i class="fas fa-arrow-right"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</main>

<script>
    document.getElementById('addOrderForm').addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const formData = new FormData(this);
        const data = Object.fromEntries(formData.entries());

        // Show loading
        Swal.fire({
            title: 'กำลังสร้างรายการ...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            },
            background: '#1d112e',
            color: '#fff'
        });

        try {
            const response = await fetch('<%= baseUrl %>/add_sale', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });

            const result = await response.json();

            if (response.ok && result.success) {
                let webhookMsg = result.webhookResponse?.message || result.webhookResponse?.msg || 'รายการถูกสร้างเรียบร้อยแล้ว';
                const webhookTitle = result.webhookResponse?.title || 'สร้างรายการสำเร็จ';
                const returnedId = result.webhookResponse?.id || result.webhookResponse?.ID;

                if (returnedId) {
                    webhookMsg += `\nID: ${returnedId}`;
                }

                Swal.fire({
                    icon: 'success',
                    title: webhookTitle,
                    text: webhookMsg,
                    background: '#1d112e',
                    color: '#fff',
                    confirmButtonColor: '#ff7eb3'
                });
                this.reset();
                this.querySelector('textarea').focus();
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'เกิดข้อผิดพลาด',
                    text: result.error || 'ไม่สามารถสร้างรายการได้',
                    background: '#1d112e',
                    color: '#fff'
                });
            }
        } catch (err) {
            console.error('Error:', err);
            Swal.fire({
                icon: 'error',
                title: 'ผิดพลาด',
                text: 'เกิดข้อผิดพลาดในการเชื่อมต่อกับเซิร์ฟเวอร์',
                background: '#1d112e',
                color: '#fff'
            });
        }
    });
</script>
    <script src="<%= typeof baseUrl !== 'undefined' ? baseUrl : '' %>/dynamic_favicon.js"></script>
</body>

</html>
